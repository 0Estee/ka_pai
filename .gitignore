#  构建/下载的工具链（347 MB、1.1 万个文件）
# 由 tools/setup-android-sdk.ps1 下载；丢了重下即可
.toolchain/

#  生成物：都能用一条命令重做 
# dist/          **不忽略**：APK 是交付物，每次构建完连它一起提交（作者 2026-10 要求）
# app/dist/      打包产物（node tools/build-web.mjs 生成，harness 与 verify-apk 都要读它）
# android/build/ aapt2/javac/d8 的中间产物
# shots/         verify-apk.ps1 的截图输出
app/dist/
android/build/
shots/
.shots/

#  工具的工作目录（脚本自己会用）
.verify-apk/
.tmp-nettest/
.tmp-*/
.tmp-*

#  拆模块那轮留下的残骸（无任何引用，可删）
.recover/
.broken-split/
.split-stage/
.split-out/

#  签名密钥 
#  见 README「已知的坑」：它是「没有就自动生成」的。
#   不进 git 不影响本机；但**换机器/重新克隆会生成新密钥**，
#   那样就再也无法覆盖安装已有版本（Android 要求同一个签名）。
#   要长期保留就单独备份一份。
android/keystore.jks

#  杂项 
*.idsig
Thumbs.db
.DS_Store
# Cloudflare 联机：wrangler 依赖与本地状态
# 游戏本体零依赖（引擎只用 node 内置模块），wrangler 只在部署时用得上：
#   npm install --no-save --registry=https://registry.npmmirror.com wrangler@4
node_modules/
cloudflare/node_modules/
cloudflare/.wrangler/
cloudflare/assets/

# 部署用的本地 token（绝不提交）
.cf-token
.gh-token
