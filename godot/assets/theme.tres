[gd_resource type="Theme" format=3]

; 默认主题：中文用系统中文字体（Windows: 微软雅黑；Android: Noto Sans CJK）。
; 不打包字体文件，避免几十 MB 的体积与字体授权问题。

[sub_resource type="SystemFont" id="SystemFont_cjk"]
font_names = PackedStringArray("Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC", "Source Han Sans SC", "PingFang SC", "Sans-Serif")
subpixel_positioning = 1

[resource]
default_font = SubResource("SystemFont_cjk")
default_font_size = 16
