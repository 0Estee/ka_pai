<?xml version="1.0" encoding="utf-8"?>
<!--
  纯 WebView 外壳：零第三方依赖（不使用 AndroidX / Gradle），
  所以可以只用 SDK build-tools 手工构建出 APK。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kaipai.prototype"
    android:versionCode="45"
    android:versionName="0.44.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!-- 局域网联机需要：INTERNET 用来起 HTTP 服务 / 发 UDP 广播，
         ACCESS_NETWORK_STATE 用来读网卡状态。两个都是安装时授予的普通权限，
         不需要运行时申请（所以没有 requestPermissions 那套代码）。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:debuggable="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
