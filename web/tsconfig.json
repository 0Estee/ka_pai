{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@engine/*": ["../engine/src/*"],
      "@cards/*": ["../engine/cards/*"],
      "@data/*": ["../data/*"],
      "@app/*": ["../app/js/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
